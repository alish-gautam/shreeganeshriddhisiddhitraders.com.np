---
import type { Category } from '../lib/models';
import type { SiteSettings } from '../lib/site';

interface Props { categories: Category[]; settings: SiteSettings }
const { categories, settings } = Astro.props;
const shortCategories = categories.slice(0, 7);
---

{settings.announcement && <div class="announcement"><div class="container-page">{settings.announcement}</div></div>}
<header class="site-header">
	<div class="container-page header-inner">
		<a class="brand" href="/" aria-label={`${settings.businessName} home`}>
			<span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M7 37.5h34M10 32V13.5h28V32M16 32V20h16v12M19.5 25.5h9M19.5 29.5h9M14 13.5l4-5h12l4 5" stroke="currentColor" stroke-width="2.3" stroke-linecap="square"/><path d="M22 8.5V4h4v4.5" stroke="currentColor" stroke-width="2.3"/></svg></span>
			<span class="brand-copy"><strong>SGRS</strong><small>TRADERS · BIRATNAGAR</small></span>
		</a>
		<nav class="desktop-nav" aria-label="Main navigation">
			<a href="/machines/">Machinery</a>
			<details class="nav-categories">
				<summary>Categories <span aria-hidden="true">⌄</span></summary>
				<div class="category-menu">
					<a href="/machines/">All machinery</a>
					{shortCategories.map((category) => <a href={`/categories/${category.slug}/`}>{category.name}</a>)}
				</div>
			</details>
			<a href="/about/">About</a>
			<a href="/services/">How it works</a>
			<a href="/guides/">Guides</a>
			<a href="/contact/">Contact</a>
		</nav>
		<div class="header-actions">
			<button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch color theme">
				<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
				<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 14.1A8.8 8.8 0 0 1 9.9 3.2 9 9 0 1 0 20.8 14.1Z"/></svg>
			</button>
			<a class="btn btn-primary header-quote" href="/contact/">Request a quote</a>
			<button class="icon-button menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle aria-label="Open navigation menu">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
			</button>
		</div>
	</div>
	<nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation" hidden data-menu>
		<div class="container-page mobile-menu-inner">
			<a href="/machines/">All machinery</a>
			{shortCategories.map((category) => <a class="mobile-sub-link" href={`/categories/${category.slug}/`}>{category.name}</a>)}
			<a href="/about/">About</a><a href="/services/">How it works</a><a href="/guides/">Guides</a><a href="/contact/">Contact</a>
			<a class="btn btn-primary" href="/contact/">Request a quote</a>
		</div>
	</nav>
</header>

<style>
	.announcement { background: var(--navy); color: #fff; font-size: .8rem; padding: .4rem 0; }
	.site-header { position: relative; z-index: 20; border-bottom: 1px solid var(--line); background: var(--page); }
	.header-inner { display: flex; min-height: 5.3rem; align-items: center; justify-content: space-between; gap: 1.25rem; }
	.brand { display: inline-flex; min-width: max-content; align-items: center; gap: .7rem; color: var(--body); text-decoration: none; }
	.brand-mark { display: grid; width: 2.7rem; height: 2.7rem; place-items: center; border-radius: .28rem; background: var(--navy); color: #fff; }
	.brand-mark svg { width: 2.2rem; }
	.brand-copy { display: grid; line-height: 1.1; }
	.brand-copy strong { font-family: var(--font-display); font-size: 1.2rem; letter-spacing: .08em; }
	.brand-copy small { margin-top: .25rem; color: var(--muted); font-size: .56rem; font-weight: 800; letter-spacing: .12em; }
	.desktop-nav { display: none; align-items: center; gap: clamp(.8rem, 1.7vw, 1.6rem); }
	.desktop-nav > a, .nav-categories > summary { color: var(--body); font-size: .86rem; font-weight: 650; text-decoration: none; cursor: pointer; }
	.desktop-nav > a:hover, .nav-categories > summary:hover { color: var(--link); }
	.nav-categories { position: relative; }
	.nav-categories summary { list-style: none; }
	.nav-categories summary::-webkit-details-marker { display: none; }
	.category-menu { position: absolute; top: calc(100% + 1rem); left: -.8rem; display: grid; min-width: 13rem; gap: .15rem; border: 1px solid var(--line); border-radius: .4rem; background: var(--page); padding: .45rem; box-shadow: var(--shadow); }
	.category-menu a { border-radius: .25rem; padding: .48rem .6rem; color: var(--body); font-size: .83rem; text-decoration: none; }
	.category-menu a:hover { background: var(--surface); color: var(--link); }
	.header-actions { display: flex; align-items: center; gap: .55rem; }
	.theme-toggle svg, .menu-toggle svg { width: 1.15rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
	.moon-icon { display: none; }
	:global(:root[data-theme="dark"]) .sun-icon { display: none; }
	:global(:root[data-theme="dark"]) .moon-icon { display: block; }
	.header-quote { display: none; }
	.mobile-menu { border-top: 1px solid var(--line); background: var(--page); }
	.mobile-menu-inner { display: grid; gap: .2rem; padding-block: .7rem 1.1rem; }
	.mobile-menu-inner > a:not(.btn) { border-radius: .25rem; padding: .55rem .15rem; color: var(--body); font-weight: 650; text-decoration: none; }
	.mobile-menu-inner > a.mobile-sub-link { padding-left: 1.2rem; color: var(--muted); font-size: .9rem; font-weight: 500; }
	.mobile-menu-inner > .btn { margin-top: .5rem; }
	@media (min-width: 64rem) { .desktop-nav { display: flex; } .header-quote { display: inline-flex; } .menu-toggle, .mobile-menu { display: none !important; } }
</style>

<script>
	const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');
	menuToggle?.addEventListener('click', () => {
		if (!menu || !menuToggle) return;
		const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!isOpen));
		menuToggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
		menu.hidden = isOpen;
	});
	menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
		menu.hidden = true;
		menuToggle?.setAttribute('aria-expanded', 'false');
		menuToggle?.setAttribute('aria-label', 'Open navigation menu');
	}));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && menu && menuToggle && !menu.hidden) {
			menu.hidden = true;
			menuToggle.setAttribute('aria-expanded', 'false');
			menuToggle.setAttribute('aria-label', 'Open navigation menu');
			menuToggle.focus();
		}
	});
	const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const root = document.documentElement;
	let storedTheme: string | null = null;
	try { storedTheme = window.localStorage.getItem('sgrs-theme'); } catch { storedTheme = null; }
	if (storedTheme === 'dark' || storedTheme === 'light') root.dataset.theme = storedTheme;
	function updateThemeLabel() {
		const dark = root.dataset.theme === 'dark';
		themeButton?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
		themeButton?.setAttribute('title', dark ? 'Use light theme' : 'Use dark theme');
	}
	updateThemeLabel();
	themeButton?.addEventListener('click', () => {
		root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
		try { window.localStorage.setItem('sgrs-theme', root.dataset.theme); } catch { /* The selected theme still applies for this page. */ }
		updateThemeLabel();
	});
</script>
