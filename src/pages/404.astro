---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Shree Ganesh Riddhi Siddhi Traders" description="The requested page could not be found.">
	<main id="main-content" class="container-page not-found"><p class="eyebrow">404 · Page not found</p><h1>This page is not here.</h1><p class="muted">The address may have changed. Browse the current catalogue or return to the homepage.</p><div class="not-found-actions"><a class="btn btn-primary" href="/machines/">Browse machinery</a><a class="btn btn-outline" href="/">Go to homepage</a></div></main>
</Layout>
<style>
	.not-found { min-height: 28rem; padding-block: 5rem; }
	.not-found h1 { max-width: 40rem; font-family: var(--font-display); font-size: clamp(2.8rem,7vw,5rem); letter-spacing: -.06em; line-height: 1.05; }
	.not-found-actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.25rem; }
</style>
